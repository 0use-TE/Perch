<Application x:Class="Perch.App" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://Perch/Views/Theme.axaml"/>
    <StyleInclude Source="avares://Perch/Views/ThemeControls.axaml"/>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Perch/Views/UiColors.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
