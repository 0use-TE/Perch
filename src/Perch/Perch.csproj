<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- An explicit RID takes precedence over the build host (also supports cross-building Windows on Linux). -->
    <PerchPlatform Condition="'$(PerchPlatform)' == '' and $(RuntimeIdentifier.StartsWith('win-'))">Windows</PerchPlatform>
    <PerchPlatform Condition="'$(PerchPlatform)' == '' and $(RuntimeIdentifier.StartsWith('linux-'))">Linux</PerchPlatform>
    <PerchPlatform Condition="'$(PerchPlatform)' == '' and $(RuntimeIdentifiers.StartsWith('win-'))">Windows</PerchPlatform>
    <PerchPlatform Condition="'$(PerchPlatform)' == '' and $(RuntimeIdentifiers.StartsWith('linux-'))">Linux</PerchPlatform>
    <PerchPlatform Condition="'$(PerchPlatform)' == '' and '$(OS)' == 'Windows_NT'">Windows</PerchPlatform>
    <PerchPlatform Condition="'$(PerchPlatform)' == ''">Linux</PerchPlatform>
    <TargetFramework Condition="'$(PerchPlatform)' == 'Windows'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(PerchPlatform)' == 'Linux'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers Condition="'$(PerchPlatform)' == 'Windows'">win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(PerchPlatform)' == 'Linux'">linux-x64</RuntimeIdentifiers>
    <ApplicationManifest Condition="'$(PerchPlatform)' == 'Windows'">app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\perch.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <!-- 0.92.0 fixes GHSA-xrw6-gwf8-vvr9 and preserves the Connection API used by Avalonia 12.0.
         0.93+ removes that API and crashes the X11 backend at startup. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" Condition="'$(PerchPlatform)' == 'Windows'" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" Condition="'$(PerchPlatform)' == 'Windows'" />
  </ItemGroup>
  <ItemGroup Condition="'$(PerchPlatform)' == 'Linux'">
    <Compile Remove="Platform/Windows/**/*.cs;ViewModels/MusicViewModel.cs;Services/AudioActivity.cs;Services/PlayerWatcher.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PerchPlatform)' == 'Windows'">
    <Compile Remove="Platform/Linux/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <InternalsVisibleTo Include="Perch.Linux.Tests" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Fonts/*.LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Publish: dotnet publish for example: dotnet publish, runtime win-x64, Release, PublishTrimmed true -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' and '$(PerchPlatform)' == 'Windows'">
    <!-- Links SkiaSharp, HarfBuzz and the other native libraries into Perch.exe: a single file. Version matches SkiaSharp 3.119.4 (Avalonia 12). -->
    <PackageReference Include="StaticLink.Avalonia" Version="3.119.4-7922.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!-- Bindings are looked up by name at run time, so everything in this assembly stays. -->
    <TrimmerRootAssembly Include="Perch" />
  </ItemGroup>


  <!-- Native AOT: dotnet publish -c Release -r win-x64 -p:PublishAot=true -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
