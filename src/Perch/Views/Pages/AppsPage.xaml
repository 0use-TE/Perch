<UserControl x:Class="Perch.Views.Pages.AppsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <ToggleButton Style="{StaticResource Chip}" Content="{DynamicResource Apps.Apps}" IsChecked="{Binding ShowsApps, Mode=OneWay}" Command="{Binding SetSection}" CommandParameter="apps"/>
    <ToggleButton Style="{StaticResource Chip}" Content="{DynamicResource Apps.Commands}" IsChecked="{Binding ShowsCommands, Mode=OneWay}" Command="{Binding SetSection}" CommandParameter="commands" Margin="4,0,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding ShowsApps, Converter={StaticResource Visible}}">
    <Grid Width="220">
     <TextBox Style="{StaticResource CompactInput}" MinHeight="30" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Apps.Search}"/>
     <TextBlock Text="{DynamicResource Apps.Search}" Margin="13,0,0,0">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
    <Button Style="{StaticResource TextButton}" Content="{Binding PinModeLabel}" Command="{Binding TogglePinMode}" Margin="6,0,0,0" ToolTip="{DynamicResource Apps.PinTip}"/>
   </StackPanel>
  </Grid>

  <!-- App grid: pinned apps first -->
  <Grid Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding ShowsApps, Converter={StaticResource Visible}}">
   <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding Visible}">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate>
     <Button Style="{StaticResource Tile}" Width="84" Height="64" Padding="4,6" ToolTip="{Binding Name}"
             Command="{Binding DataContext.Launch, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
      <StackPanel>
       <Grid Width="28" Height="28">
        <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="10" Foreground="#C9C9CE" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0"
                   Visibility="{Binding DataContext.PinMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}"/>
        <TextBlock Text="&#xE735;" Style="{StaticResource Glyph}" FontSize="10" Foreground="#FFAE54" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0"
                   Visibility="{Binding Pinned, Converter={StaticResource Visible}}"/>
       </Grid>
       <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="#C9C9CE" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" MaxWidth="76"/>
      </StackPanel>
     </Button>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}"/>
  </Grid>

  <!-- Custom command lines -->
  <Grid Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding ShowsCommands, Converter={StaticResource Visible}}">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding Commands}">
    <ListBox.ItemTemplate><DataTemplate>
     <Grid Margin="6,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Command}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource SmallIcon}" Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{DynamicResource Common.Run}">
       <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Foreground="#FFAE54"/>
      </Button>
      <Button Grid.Column="2" Style="{StaticResource SmallIcon}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{DynamicResource Common.Delete}">
       <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" Foreground="#77777D"/>
      </Button>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Text="{DynamicResource Apps.CommandsEmpty}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoCommands, Converter={StaticResource Visible}}"/>
   <Grid Grid.Row="1" Margin="0,6,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox Style="{StaticResource CompactInput}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Apps.NameField}"/>
    <TextBlock Text="{DynamicResource Apps.Name}" Margin="13,0,0,0">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NewName}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <TextBox Grid.Column="2" Style="{StaticResource CompactInput}" FontFamily="Cascadia Mono, Consolas" Text="{Binding NewCommand, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Apps.Command}">
     <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCommand}"/></TextBox.InputBindings>
    </TextBox>
    <TextBlock Grid.Column="2" Text="{DynamicResource Apps.CommandPlaceholder}" Margin="13,0,0,0">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NewCommand}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <Button Grid.Column="3" Style="{StaticResource SmallIcon}" Command="{Binding AddCommand}" Margin="6,0,0,0" ToolTip="{DynamicResource Apps.AddCommand}" AutomationProperties.Name="{DynamicResource Apps.AddCommand}"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14"/></Button>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
