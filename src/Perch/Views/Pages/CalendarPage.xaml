<UserControl x:Class="Perch.Views.Pages.CalendarPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- DataContext is the calendar view model (events from .ics links). -->
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <TextBlock VerticalAlignment="Center" Margin="4,0,0,0"><Run Text="{DynamicResource Cal.Title}" FontSize="13" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Status, Mode=OneWay}" FontSize="11" Foreground="#8A8A90"/></TextBlock>
   <Button Style="{StaticResource SmallIcon}" HorizontalAlignment="Right" Command="{Binding Refresh}" ToolTip="{DynamicResource Common.Refresh}" AutomationProperties.Name="{DynamicResource Common.Refresh}"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Foreground="#AAAAAF"/></Button>
  </Grid>
  <TextBlock Grid.Row="1" Text="{DynamicResource Cal.NoFeeds}" Style="{StaticResource Placeholder}" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="{Binding NoFeeds, Converter={StaticResource Visible}}"/>
  <TextBlock Grid.Row="1" Text="{DynamicResource Cal.Nothing}" Style="{StaticResource Placeholder}" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,6,0,0">
   <ItemsControl ItemsSource="{Binding Rows}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel>
      <TextBlock Text="{Binding DayLabel}" Style="{StaticResource Caption}" Margin="4,10,0,4" Visibility="{Binding ShowDay, Converter={StaticResource Visible}}"/>
      <Grid Margin="4,3,4,3">
       <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border CornerRadius="2" Margin="0,2">
        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#3A3A3E"/><Style.Triggers><DataTrigger Binding="{Binding Now}" Value="True"><Setter Property="Background" Value="#FFAE54"/></DataTrigger></Style.Triggers></Style></Border.Style>
       </Border>
       <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="12.5" Foreground="#C9C9CE" Margin="12,0,0,0" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="3" Text="{Binding Location}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </Grid>
</UserControl>
