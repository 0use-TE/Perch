<UserControl x:Class="Perch.Views.Pages.ClipboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- DataContext is the clipboard history view model. -->
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <TextBlock VerticalAlignment="Center" Margin="4,0,0,0"><Run Text="{DynamicResource Clip.Title}" FontSize="13" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding PausedNote, Mode=OneWay}" FontSize="11" Foreground="#FFAE54"/></TextBlock>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Style="{StaticResource TextButton}" Content="{Binding PauseLabel}" Command="{Binding TogglePause}"/>
    <Button Style="{StaticResource TextButton}" Content="{DynamicResource Clip.Clear}" Command="{Binding Clear}"/>
   </StackPanel>
  </Grid>
  <TextBlock Grid.Row="1" Text="{DynamicResource Clip.Empty}" Style="{StaticResource Placeholder}" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"/>
  <ListBox Grid.Row="1" Style="{StaticResource BareList}" ItemsSource="{Binding Items}" Margin="0,6,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
   <ListBox.ItemTemplate><DataTemplate>
    <Grid>
     <Button Style="{StaticResource Tile}" Command="{Binding DataContext.Copy, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" ToolTip="{Binding Text}">
      <Grid Margin="12,8,40,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Preview}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Style="{StaticResource Caption}" Margin="14,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </Button>
     <Button Style="{StaticResource SmallIcon}" HorizontalAlignment="Right" Margin="0,0,6,0" Command="{Binding DataContext.Remove, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{DynamicResource Clip.Remove}" AutomationProperties.Name="{DynamicResource Clip.Remove}">
      <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="11" Foreground="#8A8A90"/>
     </Button>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </Grid>
</UserControl>
