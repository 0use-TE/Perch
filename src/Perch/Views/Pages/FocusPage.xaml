<UserControl x:Class="Perch.Views.Pages.FocusPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
  <Grid Width="132" Height="132" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
   <Ellipse Stroke="#1E1E20" StrokeThickness="8"/>
   <Ellipse Stroke="{StaticResource IslandAccent}" StrokeThickness="8" StrokeDashArray="{Binding Ring}" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
    <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
   </Ellipse>
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="{Binding Remaining}" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding PhaseLabel}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Column="1" VerticalAlignment="Center">
   <StackPanel Orientation="Horizontal">
    <ToggleButton Style="{StaticResource Chip}" Content="{DynamicResource Nav.Focus}" IsChecked="{Binding IsFocus, Mode=OneWay}" Command="{Binding Select}" CommandParameter="focus"/>
    <ToggleButton Style="{StaticResource Chip}" Content="{DynamicResource Focus.Short}" IsChecked="{Binding IsShortBreak, Mode=OneWay}" Command="{Binding Select}" CommandParameter="short" Margin="4,0,0,0"/>
    <ToggleButton Style="{StaticResource Chip}" Content="{DynamicResource Focus.Long}" IsChecked="{Binding IsLongBreak, Mode=OneWay}" Command="{Binding Select}" CommandParameter="long" Margin="4,0,0,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="4,18,0,0">
    <Button Style="{StaticResource PrimaryRound}" Command="{Binding Toggle}" ToolTip="{DynamicResource Focus.StartPause}" AutomationProperties.Name="{DynamicResource Focus.StartPauseName}">
     <TextBlock Text="{Binding PlayGlyph}" Style="{StaticResource Glyph}" FontSize="18" Foreground="#1A1208"/>
    </Button>
    <Button Style="{StaticResource IconButton}" Command="{Binding Reset}" Margin="12,0,0,0" ToolTip="{DynamicResource Common.Reset}" AutomationProperties.Name="{DynamicResource Common.Reset}">
     <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="15" Foreground="#AAAAAF"/>
    </Button>
    <Button Style="{StaticResource IconButton}" Command="{Binding Skip}" Margin="4,0,0,0" ToolTip="{DynamicResource Common.Skip}" AutomationProperties.Name="{DynamicResource Common.Skip}">
     <TextBlock Text="&#xE893;" Style="{StaticResource Glyph}" FontSize="15" Foreground="#AAAAAF"/>
    </Button>
   </StackPanel>
   <TextBlock Text="{Binding RoundText}" Style="{StaticResource Caption}" Margin="6,14,0,0"/>
  </StackPanel>
  <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" VerticalAlignment="Center">
   <StackPanel>
    <TextBlock Text="{DynamicResource Focus.Today}" Style="{StaticResource Caption}"/>
    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,0"><Run Text="{Binding TodaySessions, Mode=OneWay}"/><Run Text="{DynamicResource Focus.RoundsUnit}" FontSize="13" Foreground="#A9A9AF"/></TextBlock>
    <TextBlock Text="{Binding TodayMinutes}" FontSize="12" Foreground="#A9A9AF" Margin="0,2,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
