<UserControl x:Class="Perch.Views.Pages.NotesPage" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="{DynamicResource Nav.Notes}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" Classes="Caption"/>
   <Button HorizontalAlignment="Right" Command="{Binding New}" ToolTip.Tip="{DynamicResource Notes.New}" AutomationProperties.Name="{DynamicResource Notes.New}" Classes="Nav Small"><TextBlock Text="&#xE710;" FontSize="13" Classes="Glyph"/></Button>
   <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" Classes="Bare Selectable">
    <ListBox.ItemTemplate><DataTemplate>
     <Grid Margin="10,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Classes="Caption"><Run Text="{Binding UpdatedLabel, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Preview, Mode=OneWay}"/></TextBlock>
      </StackPanel>
      <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource IslandAccent}" VerticalAlignment="Top" Margin="6,5,0,0" IsVisible="{Binding Highlight}"/>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <!-- Title: its own field, separate from the note text -->
   <Grid Background="#171717">
    <TextBox x:Name="TitleBox" FontSize="16" FontWeight="SemiBold" Padding="16,12,84,6" Text="{Binding Selected.Title}" IsEnabled="{Binding HasSelection}"
             MaxLength="120" AutomationProperties.Name="{DynamicResource Notes.TitleLabel}" Classes="Quiet"/>
    <TextBlock Text="{DynamicResource Notes.TitlePlaceholder}" FontSize="16" FontWeight="SemiBold" Margin="17,13,0,0" VerticalAlignment="Top" Classes="Placeholder" IsVisible="{Binding Selected.TitleEmpty}"/>
   </Grid>
   <Grid Grid.Row="1">
   <TextBox Padding="16,6,16,12" Text="{Binding Selected.Text}" IsEnabled="{Binding HasSelection}"
            AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource Notes.Content}" Classes="Quiet"/>
   <TextBlock Text="{DynamicResource Notes.Placeholder}" FontSize="14" Margin="17,8,0,0" VerticalAlignment="Top" Classes="Placeholder" IsVisible="{Binding Selected.BodyEmpty}"/>
   </Grid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
    <Button Command="{Binding ToggleHighlight}" ToolTip.Tip="{DynamicResource Notes.Highlight}" AutomationProperties.Name="{DynamicResource Notes.Highlight}" Classes="Nav Small">
     <TextBlock FontSize="13" Classes="Glyph" Text="{Binding Selected.Highlight, Converter={StaticResource Pick}, ConverterParameter=&#xE735;|&#xE734;}" Foreground="{Binding Selected.Highlight, Converter={StaticResource Pick}, ConverterParameter=#FFAE54|#8A8A90}"/>
    </Button>
    <Button Command="{Binding Delete}" ToolTip.Tip="{DynamicResource Notes.Delete}" AutomationProperties.Name="{DynamicResource Notes.Delete}" Classes="Nav Small"><TextBlock Text="&#xE74D;" FontSize="12" Foreground="#8A8A90" Classes="Glyph"/></Button>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
