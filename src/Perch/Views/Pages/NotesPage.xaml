<UserControl x:Class="Perch.Views.Pages.NotesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="{DynamicResource Nav.Notes}" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
   <Button Style="{StaticResource SmallIcon}" HorizontalAlignment="Right" Command="{Binding New}" ToolTip="{DynamicResource Notes.New}" AutomationProperties.Name="{DynamicResource Notes.New}"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="13"/></Button>
   <ListBox Grid.Row="1" Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource SelectableItem}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
    <ListBox.ItemTemplate><DataTemplate>
     <Grid Margin="10,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"><Run Text="{Binding UpdatedLabel, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Preview, Mode=OneWay}"/></TextBlock>
      </StackPanel>
      <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{StaticResource IslandAccent}" VerticalAlignment="Top" Margin="6,5,0,0" Visibility="{Binding Highlight, Converter={StaticResource Visible}}"/>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <!-- Title: its own field, separate from the note text -->
   <Grid Background="#171717">
    <TextBox x:Name="TitleBox" Style="{StaticResource QuietInput}" FontSize="16" FontWeight="SemiBold" Padding="16,12,84,6" Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}"
             MaxLength="120" AutomationProperties.Name="{DynamicResource Notes.TitleLabel}"/>
    <TextBlock Text="{DynamicResource Notes.TitlePlaceholder}" FontSize="16" FontWeight="SemiBold" Margin="17,13,0,0" VerticalAlignment="Top">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}"><Setter Property="FontSize" Value="16"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Selected.TitleEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <Grid Grid.Row="1">
   <TextBox Style="{StaticResource QuietInput}" Padding="16,6,16,12" Text="{Binding Selected.Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}"
            AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource Notes.Content}"/>
   <TextBlock Text="{DynamicResource Notes.Placeholder}" FontSize="14" Margin="17,8,0,0" VerticalAlignment="Top">
    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Selected.BodyEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   </Grid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
    <Button Style="{StaticResource SmallIcon}" Command="{Binding ToggleHighlight}" ToolTip="{DynamicResource Notes.Highlight}" AutomationProperties.Name="{DynamicResource Notes.Highlight}">
     <TextBlock FontSize="13">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}"><Setter Property="Text" Value="&#xE734;"/><Setter Property="Foreground" Value="#8A8A90"/><Style.Triggers><DataTrigger Binding="{Binding Selected.Highlight}" Value="True"><Setter Property="Text" Value="&#xE735;"/><Setter Property="Foreground" Value="#FFAE54"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Button>
    <Button Style="{StaticResource SmallIcon}" Command="{Binding Delete}" ToolTip="{DynamicResource Notes.Delete}" AutomationProperties.Name="{DynamicResource Notes.Delete}"><TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" Foreground="#8A8A90"/></Button>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
