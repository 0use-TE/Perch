<UserControl x:Class="Perch.Views.Pages.PhotosPage" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Perch.ViewModels" x:DataType="vm:PhotosViewModel">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <TextBlock VerticalAlignment="Center" Margin="4,0,0,0"><Run Text="{Binding FolderName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Status, Mode=OneWay}" FontSize="11" Foreground="#8A8A90"/></TextBlock>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Command="{Binding Reload}" ToolTip.Tip="{DynamicResource Common.Refresh}" AutomationProperties.Name="{DynamicResource Photos.Refresh}" Classes="Nav Small"><TextBlock Text="&#xE72C;" FontSize="12" Foreground="#AAAAAF" Classes="Glyph"/></Button>
    <Button Content="{DynamicResource Photos.OpenFolder}" Command="{Binding OpenFolder}" Classes="Text"/>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
   <ItemsControl ItemsSource="{Binding Items}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PhotoItem">
     <Button Margin="0,0,8,0" Command="{Binding $parent[UserControl].((vm:PhotosViewModel)DataContext).Open}" CommandParameter="{Binding}" ToolTip.Tip="{Binding FullPath}" Classes="Tile">
      <Border Width="124" Height="124" CornerRadius="12" Background="#18181A">
       <Border CornerRadius="12">
        <Border.Background><ImageBrush Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background>
       </Border>
      </Border>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </Grid>
</UserControl>
