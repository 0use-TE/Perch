<UserControl x:Class="Perch.Views.Pages.PhotosPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <TextBlock VerticalAlignment="Center" Margin="4,0,0,0"><Run Text="{Binding FolderName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Status, Mode=OneWay}" FontSize="11" Foreground="#8A8A90"/></TextBlock>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Style="{StaticResource SmallIcon}" Command="{Binding Reload}" ToolTip="{DynamicResource Common.Refresh}" AutomationProperties.Name="{DynamicResource Photos.Refresh}"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Foreground="#AAAAAF"/></Button>
    <Button Style="{StaticResource TextButton}" Content="{DynamicResource Photos.OpenFolder}" Command="{Binding OpenFolder}"/>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnWheel" Focusable="False">
   <ItemsControl ItemsSource="{Binding Items}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Style="{StaticResource Tile}" Margin="0,0,8,0" Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding FullPath}">
      <Border Width="124" Height="124" CornerRadius="12" Background="#18181A">
       <Border CornerRadius="12">
        <Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background>
       </Border>
      </Border>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </Grid>
</UserControl>
