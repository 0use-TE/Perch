<UserControl x:Class="Perch.Views.Pages.SystemPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- DataContext is the system monitor view model. -->
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Margin="0,0,5,0" Padding="20,16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{DynamicResource Sys.Cpu}" Style="{StaticResource Caption}"/>
    <TextBlock Grid.Row="1" Text="{Binding CpuText}" FontFamily="Segoe UI Variable Display" FontSize="40" FontWeight="SemiBold" Margin="0,2,0,0"/>
    <Polyline Grid.Row="2" Points="{Binding CpuLine}" Stretch="Fill" Stroke="{StaticResource IslandAccent}" StrokeThickness="1.8" StrokeLineJoin="Round" Margin="0,8,0,8"/>
    <TextBlock Grid.Row="3" Text="{Binding CpuDetail}" Style="{StaticResource Caption}"/>
   </Grid>
  </Border>
  <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0" Padding="20,16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{DynamicResource Sys.Memory}" Style="{StaticResource Caption}"/>
    <TextBlock Grid.Row="1" Text="{Binding MemoryText}" FontFamily="Segoe UI Variable Display" FontSize="40" FontWeight="SemiBold" Margin="0,2,0,0"/>
    <Polyline Grid.Row="2" Points="{Binding MemoryLine}" Stretch="Fill" Stroke="#7FB2FF" StrokeThickness="1.8" StrokeLineJoin="Round" Margin="0,8,0,8"/>
    <TextBlock Grid.Row="3" Text="{Binding MemoryDetail}" Style="{StaticResource Caption}"/>
   </Grid>
  </Border>
  <Border Grid.Column="2" Style="{StaticResource Card}" Margin="5,0,0,0" Padding="20,16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Style="{StaticResource Caption}"><Run Text="{DynamicResource Sys.Disk}"/><Run Text="  "/><Run Text="{Binding DiskName, Mode=OneWay}"/></TextBlock>
    <TextBlock Grid.Row="1" Text="{Binding DiskText}" FontFamily="Segoe UI Variable Display" FontSize="40" FontWeight="SemiBold" Margin="0,2,0,0"/>
    <ProgressBar Grid.Row="2" Height="6" Minimum="0" Maximum="100" Value="{Binding Disk, Mode=OneWay}" Foreground="#9BE08C" Background="#2A2A2E" BorderThickness="0" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="3"><TextBlock Text="{Binding DiskDetail}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Uptime}" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
