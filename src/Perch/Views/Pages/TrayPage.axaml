<UserControl x:Class="Perch.Views.Pages.TrayPage" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Perch.ViewModels" x:DataType="vm:TrayViewModel">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <TextBlock VerticalAlignment="Center" Margin="4,0,0,0"><Run Text="{DynamicResource Nav.Tray}" FontSize="13" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding CountText, Mode=OneWay}" FontSize="11" Foreground="#8A8A90"/></TextBlock>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding HasFiles}">
    <Button Content="{DynamicResource Common.Open}" Command="{Binding Open}" IsEnabled="{Binding HasSelection}" Classes="Text"/>
    <Button Content="{DynamicResource Tray.Reveal}" Command="{Binding Reveal}" IsEnabled="{Binding HasSelection}" Classes="Text"/>
    <Button Content="{DynamicResource Tray.ToPng}" Command="{Binding Convert}" CommandParameter="png" IsEnabled="{Binding CanConvert}" Classes="Text"/>
    <Button Content="{DynamicResource Tray.ToJpg}" Command="{Binding Convert}" CommandParameter="jpg" IsEnabled="{Binding CanConvert}" Classes="Text"/>
    <Button Content="{DynamicResource Tray.Zip}" Command="{Binding Zip}" Classes="Text"/>
    <Button Content="{DynamicResource Common.Remove}" Command="{Binding Remove}" IsEnabled="{Binding HasSelection}" Classes="Text"/>
    <Button Content="{DynamicResource Common.Clear}" Command="{Binding Clear}" Classes="Text"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,8,0,0">
   <ListBox x:Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding Selected, Mode=TwoWay}"
             Classes="Bare Selectable">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:TrayFile">
     <StackPanel Width="96" Margin="4,8" ToolTip.Tip="{Binding FullPath}">
      <Grid Width="76" Height="52" HorizontalAlignment="Center">
       <Border IsVisible="{Binding HasPreview}" CornerRadius="7" ClipToBounds="True"><Image Source="{Binding Preview}" Stretch="UniformToFill"/></Border>
       <Image Source="{Binding Icon}" Width="32" Height="32" IsVisible="{Binding NoPreview}"/>
      </Grid>
      <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,6,2,0"/>
      <TextBlock Text="{Binding Detail}" FontSize="10" HorizontalAlignment="Center" Classes="Caption"/>
     </StackPanel>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="{Binding IsEmpty}">
    <TextBlock Text="&#xE896;" FontSize="26" Foreground="#55555B" Classes="Glyph"/>
    <TextBlock Text="{DynamicResource Tray.EmptyTitle}" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    <TextBlock Text="{DynamicResource Tray.EmptyHint}" HorizontalAlignment="Center" Margin="0,4,0,0" Classes="Caption"/>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
