<Window x:Class="Perch.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Settings.Title}" Icon="pack://application:,,,/Assets/perch.ico" Width="820" Height="640" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Ui.Tint}" Foreground="{DynamicResource Ui.Text}" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/></Style>
  <Style x:Key="FeatureIcon" TargetType="Border"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Background" Value="{DynamicResource Ui.Tile}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="FeatureGlyph" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{DynamicResource Ui.TileIcon}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="PlaceItem" TargetType="ListBoxItem">
   <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Pill" CornerRadius="8" Background="Transparent" Padding="12,9"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource Ui.Hover}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- No keyboard focus rectangle (the white frame) around the scrolling page. -->
  <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}"><Setter Property="Focusable" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Ui.Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Ui.CardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Margin" Value="0,0,0,20"/></Style>
  <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/><Setter Property="Margin" Value="6,0,0,8"/></Style>
  <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="13.5"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource Ui.Desc}"/><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Row" TargetType="Grid"><Setter Property="Margin" Value="18,13"/></Style>
  <Style x:Key="Divider" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource Ui.Divider}"/><Setter Property="Margin" Value="18,0"/></Style>
  <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Width" Value="44"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource CompactInput}"><Setter Property="Background" Value="{DynamicResource Ui.Field}"/><Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/></Style>
  <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource Field}"><Setter Property="Width" Value="84"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  <!-- Our own caption buttons: 46 x 52, glyph centred, red on close. -->
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Focusable" Value="False"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="52"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bg" Background="Transparent"><TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{DynamicResource Ui.Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Ui.CaptionHover}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bg" Background="Transparent"><TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{DynamicResource Ui.Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#C42B1C"/><Setter TargetName="Glyph" Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Sidebar: the title bar is part of it, so there is no separate caption strip. -->
  <Border Background="{DynamicResource Ui.Sidebar}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
     <Image Source="pack://application:,,,/Assets/perch.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
     <TextBlock Text="Perch" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="1" x:Name="Sidebar" Margin="12,8,12,0" RadioButton.Checked="OnPage">
     <RadioButton Style="{StaticResource SidebarItem}" GroupName="page" Tag="&#xE7F9;" Content="{DynamicResource Set.Island}" IsChecked="True"/>
     <RadioButton Style="{StaticResource SidebarItem}" GroupName="page" Tag="&#xE8F1;" Content="{DynamicResource Set.Widgets}"/>
     <RadioButton Style="{StaticResource SidebarItem}" GroupName="page" Tag="&#xEA8F;" Content="{DynamicResource Set.Reminders}"/>
     <RadioButton Style="{StaticResource SidebarItem}" GroupName="page" Tag="&#xE713;" Content="{DynamicResource Set.General}"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimize"/>
    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnDone" AutomationProperties.Name="Close"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <Grid Margin="34,2,34,24">
     <!-- Island -->
     <StackPanel x:Name="PageIsland">
      <TextBlock Text="{DynamicResource Set.Island}" Style="{StaticResource Heading}"/>
      <!-- Live preview: the island as it looks closed, over a stand-in wallpaper. -->
      <Border CornerRadius="14" Height="112" Margin="0,0,0,20" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF6A2B" Offset="0"/><GradientStop Color="#C0508A" Offset="0.5"/><GradientStop Color="#2E9FD6" Offset="1"/></LinearGradientBrush></Border.Background>
       <Canvas x:Name="PreviewStage" HorizontalAlignment="Center" Width="260" Height="112">
        <Path x:Name="PreviewOutline"/><Path x:Name="PreviewGrain" IsHitTestVisible="False"/><Path x:Name="PreviewSheen" IsHitTestVisible="False"/>
        <TextBlock x:Name="PreviewText" Text="Perch" FontSize="12" FontWeight="SemiBold" Foreground="White" Canvas.Left="44" Canvas.Top="9"/>
        <TextBlock x:Name="PreviewTime" Text="10:21" FontSize="12" Foreground="#C4C4CA" Canvas.Left="190" Canvas.Top="9"/>
       </Canvas></Border>
      <TextBlock Text="{DynamicResource Set.Look}" Style="{StaticResource GroupTitle}"/>
      <Border Style="{StaticResource Card}"><StackPanel>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Set.Form}" Style="{StaticResource RowTitle}"/>
        <Border Grid.Column="1" Style="{StaticResource Segmented}"><StackPanel Orientation="Horizontal">
         <RadioButton GroupName="form" Style="{StaticResource Segment}" Content="{DynamicResource Set.FormStandard}" IsChecked="{Binding Shape, Converter={StaticResource StrEq}, ConverterParameter=standard}"/>
         <RadioButton GroupName="form" Style="{StaticResource Segment}" Content="{DynamicResource Set.FormCapsule}" IsChecked="{Binding Shape, Converter={StaticResource StrEq}, ConverterParameter=capsule}"/>
        </StackPanel></Border></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Set.Appearance}" Style="{StaticResource RowTitle}"/>
        <Border Grid.Column="1" Style="{StaticResource Segmented}"><StackPanel Orientation="Horizontal">
         <RadioButton GroupName="look" Style="{StaticResource Segment}" Content="{DynamicResource Set.Solid}" IsChecked="{Binding Appearance, Converter={StaticResource StrEq}, ConverterParameter=black}"/>
         <RadioButton GroupName="look" Style="{StaticResource Segment}" Content="{DynamicResource Set.Glass}" IsChecked="{Binding Appearance, Converter={StaticResource StrEq}, ConverterParameter=glass}"/>
        </StackPanel></Border></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid x:Name="GlassRow" Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource Set.GlassOpacity}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Set.GlassOpacityDesc}" Style="{StaticResource RowDesc}"/></StackPanel>
        <Slider x:Name="GlassSlider" Grid.Column="1" Style="{StaticResource Dotted}" Minimum="10" Maximum="95" Value="{Binding GlassOpacity}" AutomationProperties.Name="{DynamicResource Set.GlassOpacity}"/>
        <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=GlassSlider, Converter={StaticResource Percent}}"/></Grid>
      </StackPanel></Border>

      <TextBlock Text="{DynamicResource Set.Behavior}" Style="{StaticResource GroupTitle}"/>
      <Border Style="{StaticResource Card}"><StackPanel>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Set.Expand}" Style="{StaticResource RowTitle}"/>
        <Border Grid.Column="1" Style="{StaticResource Segmented}"><StackPanel Orientation="Horizontal">
         <RadioButton GroupName="open" Style="{StaticResource Segment}" Content="{DynamicResource Set.ExpandHover}" IsChecked="{Binding HoverExpand, Converter={StaticResource BoolChoice}, ConverterParameter=true}"/>
         <RadioButton GroupName="open" Style="{StaticResource Segment}" Content="{DynamicResource Set.ExpandClick}" IsChecked="{Binding HoverExpand, Converter={StaticResource BoolChoice}, ConverterParameter=false}"/>
        </StackPanel></Border></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource Set.Collapse}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Set.CollapseDesc}" Style="{StaticResource RowDesc}"/></StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Segmented}"><StackPanel Orientation="Horizontal">
         <RadioButton GroupName="close" Style="{StaticResource Segment}" Content="{DynamicResource Set.CollapseLeave}" IsChecked="{Binding CollapseOnLeave, Converter={StaticResource BoolChoice}, ConverterParameter=true}"/>
         <RadioButton GroupName="close" Style="{StaticResource Segment}" Content="{DynamicResource Set.CollapseClick}" IsChecked="{Binding CollapseOnLeave, Converter={StaticResource BoolChoice}, ConverterParameter=false}"/>
        </StackPanel></Border></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource Set.ReduceMotion}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Set.ReduceMotionDesc}" Style="{StaticResource RowDesc}"/></StackPanel>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ReducedMotion}" AutomationProperties.Name="{DynamicResource Set.ReduceMotion}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.NetSpeed}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ShowNetworkSpeed}" AutomationProperties.Name="{DynamicResource Settings.NetSpeed}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Fullscreen}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HideInFullscreen}" AutomationProperties.Name="{DynamicResource Settings.Fullscreen}"/></Grid>
      </StackPanel></Border>
     </StackPanel>

     <!-- Features: each one can be hidden from the island; options fold away until the card is opened -->
     <StackPanel x:Name="PageFeatures" Visibility="Collapsed">
      <TextBlock Text="{DynamicResource Set.Widgets}" Style="{StaticResource Heading}"/>
      <Expander Style="{StaticResource FeatureExpander}">
       <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE700;" Style="{StaticResource FeatureGlyph}"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Set.NavTitle}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Set.NavDesc}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
       </Grid></Expander.Header>
       <StackPanel Margin="0,6,0,8">
        <ItemsControl x:Name="NavList" Background="Transparent" MouseMove="OnNavMove" MouseLeftButtonUp="OnNavUp" LostMouseCapture="OnNavLost">
         <ItemsControl.ItemTemplate><DataTemplate>
          <!-- Drag a row by its handle: the row follows the pointer and the others slide aside to show the new order. -->
          <Grid x:Name="NavRowRoot" Background="Transparent" PreviewMouseLeftButtonDown="OnNavPress">
           <Grid Margin="18,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#x2807;&#x2807;" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="{DynamicResource Ui.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="SizeAll" ToolTip="{DynamicResource Set.NavDrag}"/>
            <Border Grid.Column="1" Style="{StaticResource FeatureIcon}" Width="30" Height="30"><TextBlock Text="{Binding Glyph}" Style="{StaticResource FeatureGlyph}" FontSize="14"/></Border>
            <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource RowTitle}" Margin="12,0,8,0" FontSize="13"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource Set.NavPin}" Style="{StaticResource RowDesc}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding Pinned}" Click="OnNavPin" AutomationProperties.Name="{DynamicResource Set.NavPin}"/>
           </Grid>
          </Grid>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NavStatus" Style="{StaticResource RowDesc}" Margin="18,8,18,0" Visibility="Collapsed"/>
       </StackPanel>
      </Expander>
      <Expander Style="{StaticResource FeatureExpander}">
       <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE8D6;" Style="{StaticResource FeatureGlyph}"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Music}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Music}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowMusic}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Music}"/>
       </Grid></Expander.Header>
       <StackPanel>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Set.MusicCompact}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding MusicInCompact}" AutomationProperties.Name="{DynamicResource Set.MusicCompact}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <StackPanel Margin="18,13,18,6">
        <TextBlock Text="{DynamicResource Set.PlayerKeys}" Style="{StaticResource RowTitle}"/>
        <TextBlock Text="{DynamicResource Set.PlayerKeysDesc}" Style="{StaticResource RowDesc}"/>
        <ItemsControl ItemsSource="{Binding PlayerKeys}">
         <ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Margin="0,12,0,0">
           <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" FontSize="12.5"/>
           <UniformGrid Columns="3" Margin="0,6,0,0">
            <StackPanel Margin="0,0,6,0"><TextBlock Text="{DynamicResource Music.PlayPause}" Style="{StaticResource RowDesc}" Margin="0,0,0,4"/>
             <TextBox Style="{StaticResource Field}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow" TextAlignment="Center" Text="{Binding Play, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnHotkeyKey"/></StackPanel>
            <StackPanel Margin="3,0"><TextBlock Text="{DynamicResource Music.Previous}" Style="{StaticResource RowDesc}" Margin="0,0,0,4"/>
             <TextBox Style="{StaticResource Field}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow" TextAlignment="Center" Text="{Binding Previous, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnHotkeyKey"/></StackPanel>
            <StackPanel Margin="6,0,0,0"><TextBlock Text="{DynamicResource Music.Next}" Style="{StaticResource RowDesc}" Margin="0,0,0,4"/>
             <TextBox Style="{StaticResource Field}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow" TextAlignment="Center" Text="{Binding Next, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnHotkeyKey"/></StackPanel>
           </UniformGrid>
          </StackPanel>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </StackPanel>
      </Expander>
      <Expander Style="{StaticResource FeatureExpander}">
       <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE916;" Style="{StaticResource FeatureGlyph}"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Focus}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Focus}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowFocus}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Focus}"/>
       </Grid></Expander.Header>
       <StackPanel>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Pomodoro}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/><TextBox Grid.Column="1" Style="{StaticResource Number}" Text="{Binding FocusMinutes}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Focus.Short}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/><TextBox Grid.Column="1" Style="{StaticResource Number}" Text="{Binding ShortBreakMinutes}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.LongBreak}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/><TextBox Grid.Column="1" Style="{StaticResource Number}" Text="{Binding LongBreakMinutes}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.AutoContinue}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding FocusAutoContinue}" AutomationProperties.Name="{DynamicResource Settings.AutoContinue}"/></Grid>
      </StackPanel>
      </Expander>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid Margin="16,0,40,0" MinHeight="62">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE73A;" Style="{StaticResource FeatureGlyph}"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Todo}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Todo}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
       <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowTodo}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Todo}"/>
      </Grid></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid Margin="16,0,40,0" MinHeight="62">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE70B;" Style="{StaticResource FeatureGlyph}"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Notes}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Notes}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
       <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowNotes}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Notes}"/>
      </Grid></Border>
      <Expander Style="{StaticResource FeatureExpander}">
       <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE787;" Style="{StaticResource FeatureGlyph}"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Calendar}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Calendar}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowCalendar}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Calendar}"/>
       </Grid></Expander.Header>
       <StackPanel>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource Set.CalendarWindows}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Set.CalendarWindowsDesc}" Style="{StaticResource RowDesc}"/></StackPanel>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding CalendarWindows}" AutomationProperties.Name="{DynamicResource Set.CalendarWindows}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <StackPanel Margin="18,13">
        <TextBlock Text="{DynamicResource Set.CalendarUrls}" Style="{StaticResource RowTitle}"/>
        <TextBlock Text="{DynamicResource Set.CalendarUrlsDesc}" Style="{StaticResource RowDesc}" Margin="0,3,0,10"/>
        <TextBox Style="{StaticResource Field}" Text="{Binding CalendarUrls}" AcceptsReturn="True" TextWrapping="NoWrap" Height="78" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource Set.CalendarUrls}"/>
       </StackPanel>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Set.CalendarRemind}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/><TextBox Grid.Column="1" Style="{StaticResource Number}" Text="{Binding CalendarReminder}"/></Grid>
      </StackPanel>
      </Expander>
      <Expander Style="{StaticResource FeatureExpander}">
       <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE753;" Style="{StaticResource FeatureGlyph}"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Info}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Info}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowInfo}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Info}"/>
       </Grid></Expander.Header>
       <StackPanel>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource Set.Place}" Style="{StaticResource RowTitle}"/><TextBlock x:Name="PlaceCurrent" Style="{StaticResource RowDesc}"/></StackPanel>
        <Button Grid.Column="1" x:Name="UseLocationButton" Style="{StaticResource PillButton}" Content="{DynamicResource Set.UseLocation}" Click="OnUseLocation"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <StackPanel Margin="18,13">
        <Grid>
         <TextBox x:Name="PlaceBox" Style="{StaticResource Field}" TextChanged="OnPlaceTextChanged" AutomationProperties.Name="{DynamicResource Set.PlaceSearch}"/>
         <TextBlock Text="{DynamicResource Set.PlaceSearch}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Ui.Desc}">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PlaceBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Grid>
        <ListBox x:Name="PlaceResults" Visibility="Collapsed" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" ItemContainerStyle="{StaticResource PlaceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="210" SelectionChanged="OnPlaceChosen">
         <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="PlaceStatus" Style="{StaticResource RowDesc}" Visibility="Collapsed"/>
       </StackPanel>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Fahrenheit}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Fahrenheit}" AutomationProperties.Name="{DynamicResource Settings.Fahrenheit}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.WeatherAlerts}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding WeatherAlerts}" AutomationProperties.Name="{DynamicResource Settings.WeatherAlerts}"/></Grid>
      </StackPanel>
      </Expander>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid Margin="16,0,40,0" MinHeight="62">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE71D;" Style="{StaticResource FeatureGlyph}"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Apps}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Apps}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
       <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowApps}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Apps}"/>
      </Grid></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid Margin="16,0,40,0" MinHeight="62">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE896;" Style="{StaticResource FeatureGlyph}"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Tray}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Tray}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
       <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowTray}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Tray}"/>
      </Grid></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid Margin="16,0,40,0" MinHeight="62">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE77F;" Style="{StaticResource FeatureGlyph}"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Clipboard}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Clipboard}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
       <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowClipboard}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Clipboard}"/>
      </Grid></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid Margin="16,0,40,0" MinHeight="62">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE7F4;" Style="{StaticResource FeatureGlyph}"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.System}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.System}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
       <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowSystem}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.System}"/>
      </Grid></Border>
      <Expander Style="{StaticResource FeatureExpander}">
       <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource FeatureIcon}"><TextBlock Text="&#xE91B;" Style="{StaticResource FeatureGlyph}"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,12,0"><TextBlock Text="{DynamicResource Nav.Photos}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Feat.Photos}" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/></StackPanel>
        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowPhotos}" ToolTip="{DynamicResource Set.ShowPage}" AutomationProperties.Name="{DynamicResource Nav.Photos}"/>
       </Grid></Expander.Header>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox Style="{StaticResource Field}" Text="{Binding PhotoFolder}" ToolTip="{DynamicResource Settings.PhotoTip}"/>
       <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="{DynamicResource Settings.Browse}" Click="OnPickFolder" Margin="10,0,0,0"/></Grid>
      </Expander>
     </StackPanel>

     <!-- Reminders -->
     <StackPanel x:Name="PageReminders" Visibility="Collapsed">
      <TextBlock Text="{DynamicResource Set.Reminders}" Style="{StaticResource Heading}"/>
      <Border Style="{StaticResource Card}"><StackPanel>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Water}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <TextBox Grid.Column="1" Style="{StaticResource Number}" Text="{Binding WaterMinutes}" Margin="0,0,14,0"/>
        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding WaterReminder}" AutomationProperties.Name="{DynamicResource Settings.Water}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Sit}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <TextBox Grid.Column="1" Style="{StaticResource Number}" Text="{Binding SitMinutes}" Margin="0,0,14,0"/>
        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding SitReminder}" AutomationProperties.Name="{DynamicResource Settings.Sit}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Bedtime}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <TextBox Grid.Column="1" Style="{StaticResource Number}" Text="{Binding Bedtime}" Margin="0,0,14,0"/>
        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding BedtimeReminder}" AutomationProperties.Name="{DynamicResource Settings.Bedtime}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Battery}" Style="{StaticResource RowTitle}" Margin="0,0,16,0"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding BatteryAlerts}" AutomationProperties.Name="{DynamicResource Settings.Battery}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Sound}" Style="{StaticResource RowTitle}"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AlertSound}" AutomationProperties.Name="{DynamicResource Settings.Sound}"/></Grid>
      </StackPanel></Border>
     </StackPanel>

     <!-- General -->
     <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
      <TextBlock Text="{DynamicResource Set.General}" Style="{StaticResource Heading}"/>
      <Border Style="{StaticResource Card}"><StackPanel>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource Set.Theme}" Style="{StaticResource RowTitle}"/><TextBlock Text="{DynamicResource Set.ThemeDesc}" Style="{StaticResource RowDesc}"/></StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Segmented}"><StackPanel Orientation="Horizontal">
         <RadioButton GroupName="theme" Style="{StaticResource Segment}" Content="{DynamicResource Set.ThemeDark}" IsChecked="{Binding Theme, Converter={StaticResource StrEq}, ConverterParameter=dark}"/>
         <RadioButton GroupName="theme" Style="{StaticResource Segment}" Content="{DynamicResource Set.ThemeLight}" IsChecked="{Binding Theme, Converter={StaticResource StrEq}, ConverterParameter=light}"/>
         <RadioButton GroupName="theme" Style="{StaticResource Segment}" Content="{DynamicResource Set.ThemeSystem}" IsChecked="{Binding Theme, Converter={StaticResource StrEq}, ConverterParameter=system}"/>
        </StackPanel></Border></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource RowTitle}"/>
        <ComboBox x:Name="LanguageBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Language}" AutomationProperties.Name="{DynamicResource Settings.Language}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Settings.Startup}" Style="{StaticResource RowTitle}"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding LaunchAtStartup}" AutomationProperties.Name="{DynamicResource Settings.Startup}"/></Grid>
      </StackPanel></Border>
           <TextBlock Text="{DynamicResource Set.Shortcuts}" Style="{StaticResource GroupTitle}"/>
      <Border Style="{StaticResource Card}"><StackPanel>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Set.HotkeysOn}" Style="{StaticResource RowTitle}"/>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HotkeysEnabled}" AutomationProperties.Name="{DynamicResource Set.HotkeysOn}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Set.HotkeyIsland}" Style="{StaticResource RowTitle}"/>
        <TextBox Grid.Column="1" Style="{StaticResource Field}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow" TextAlignment="Center" Text="{Binding HotkeyIsland, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnHotkeyKey" AutomationProperties.Name="{DynamicResource Set.HotkeyIsland}"/></Grid>
       <Border Style="{StaticResource Divider}"/>
       <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Set.HotkeyNote}" Style="{StaticResource RowTitle}"/>
        <TextBox Grid.Column="1" Style="{StaticResource Field}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow" TextAlignment="Center" Text="{Binding HotkeyNote, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnHotkeyKey" AutomationProperties.Name="{DynamicResource Set.HotkeyNote}"/></Grid>
      </StackPanel></Border>
      <TextBlock Text="{DynamicResource Set.HotkeyHint}" Style="{StaticResource RowDesc}" Margin="6,-10,0,0"/>
      <TextBlock x:Name="HotkeyStatus" Style="{StaticResource RowDesc}" Foreground="#FF7A6B" Margin="6,6,0,0" Visibility="Collapsed"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
