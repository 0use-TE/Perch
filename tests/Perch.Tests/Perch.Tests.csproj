<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-platform checks of Perch's own logic (markdown, AI client and agent, view models, settings). No test framework:
       run it with dotnet run on this project in Release; the exit code is the number of failed checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants Condition="'$(OS)' == 'Windows_NT'">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Perch/Perch.csproj" />
  </ItemGroup>
</Project>
